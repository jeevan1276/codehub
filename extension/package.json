{
  "name": "codehub",
  "version": "1.0.0",
  "description": "Competitive Programming Submission Syncer - Chrome/Edge Extension",
  "private": true,
  "scripts": {
    "lint": "eslint . --ext .js",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "node build.js && web-ext build --source-dir dist --artifacts-dir ../web-ext-artifacts",
    "dev": "node build.js --dev && web-ext run --source-dir dist"
  },
  "devDependencies": {
    "esbuild": "^0.19.11",
    "eslint": "^8.56.0",
    "vitest": "^1.2.0",
    "web-ext": "^7.10.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}